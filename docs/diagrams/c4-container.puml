@startuml c4-container
' C4 Container diagram for golang-web.
' Pinned include — never `master`, which changes under us without warning.
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.14.0/C4_Container.puml

skinparam backgroundColor #FAFAFA
skinparam shadowing false
skinparam roundCorner 4
skinparam defaultFontName "Inter, Helvetica, Arial, sans-serif"
skinparam defaultFontSize 13
skinparam ArrowColor #37474F
skinparam ArrowThickness 1.2
skinparam rectangleBorderThickness 1.3

UpdateElementStyle("person",       $fontColor="#FFFFFF", $bgColor="#0F766E", $borderColor="#134E4A")
UpdateElementStyle("container",    $fontColor="#FFFFFF", $bgColor="#2563EB", $borderColor="#1E3A8A")
UpdateElementStyle("external_system", $fontColor="#FFFFFF", $bgColor="#64748B", $borderColor="#475569")
UpdateBoundaryStyle($bgColor="#F1F5F9", $borderColor="#94A3B8", $fontColor="#1E293B")

LAYOUT_LEFT_RIGHT()

title golang-web — Container view

Person(operator, "Operator / client", "Curls the service, scrapes metrics, runs the e2e suite")
System_Ext(prometheus, "Prometheus (optional)", "Not part of this repo. Any Prometheus you run can scrape /metrics.")

System_Boundary(cluster, "Kubernetes test cluster (KinD locally)") {
    Container(svc, "golang-web-service", "Service type=LoadBalancer", "Exposes port 8080; the external IP is allocated by cloud-provider-kind on KinD")
    Container(app, "golang-web", "Go 1.27 · net/http · distroless nonroot", "Single static binary /manager. Serves the main page on /myhello/ (APP_CONTEXT), /healthz, /metrics and /shutdown. Prints the pod name, namespace, node, IP and service account that Kubernetes sets (Downward API). Runs as uid 65532 with a read-only rootfs and ALL capabilities dropped.")
}

System_Ext(ghcr, "GHCR", "ghcr.io/andriykalashnykov/golang-web — multi-arch image, cosign keyless-signed on tag builds")

Rel(operator, svc, "HTTP :8080", "GET /myhello/, /healthz")
Rel(prometheus, svc, "Scrapes", "GET /metrics")
Rel(svc, app, "Routes to targetPort 8080", "TCP")
Rel_Back(app, ghcr, "Image pulled from (kubectl deploy; make e2e loads a local build instead)", "OCI")

SHOW_LEGEND()
@enduml
