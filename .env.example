# Settings for golang-web. Copy to .env (gitignored) and uncomment what you change.
#
#   cp .env.example .env
#
# The Makefile reads .env. Every line is `?=`, so a value you set in your shell or on the
# command line still wins: command line > shell > .env > default (a variable exported
# empty in your shell also wins).
# Values are make syntax: no quotes, no inline comments, write `$` as `$$`, no `#`.
# `make check-env` fails if a setting the code reads is missing from this file.

# --- Application (read by main.go) ---------------------------------------------------------
# `make run` and `make image-run-bg` pass these to the app; empty means the default.
# PORT is set from APP_PORT by `make run`; the container always listens on 8080.
# PORT ?= 8080
# APP_CONTEXT ?= /
# MESSAGE_TO ?= World
# Set by Kubernetes from the pod spec (Downward API); shown as "empty" when unset.
# MY_NODE_NAME ?= 
# MY_POD_NAME ?= 
# MY_POD_NAMESPACE ?= 
# MY_POD_IP ?= 
# MY_POD_SERVICE_ACCOUNT ?= 

# --- Local ports and timing ----------------------------------------------------------------
# Host port for `make run`, image-run-bg and image-test-fg.
# APP_PORT ?= 8080
# Port of golang-web-service (KinD, e2e).
# SERVICE_PORT ?= 8080
# kind-deploy: how long to wait for the rollout.
# ROLLOUT_TIMEOUT ?= 120s
# kind-deploy: how long to wait for a LoadBalancer IP.
# LB_WAIT_TIMEOUT ?= 120s
# kind-deploy and e2e: attempts to reach the service.
# LB_ROUTE_RETRIES ?= 60
# Seconds between those attempts.
# LB_POLL_INTERVAL ?= 2
# Seconds per HTTP attempt.
# CURL_MAX_TIME ?= 3
# coverage-check minimum, in percent.
# COVERAGE_THRESHOLD ?= 75

# --- Container engine and image -------------------------------------------------------------
# podman or docker. Default: podman if installed, else docker.
# CONTAINER_ENGINE ?= podman
# Engine for KinD's own containers.
# KIND_ENGINE ?= docker
# image-build platform. Default: linux/amd64 on arm64 hosts, native elsewhere. Empty = native.
# PLATFORM ?= linux/amd64
# Namespace for the KinD deployment.
# KIND_NAMESPACE ?= default
# ci-run: job container image.
# ACT_RUNNER_IMAGE ?= catthehacker/ubuntu:act-latest
# ci-run: job architecture. Default: the Docker engine's.
# ACT_ARCH ?= linux/amd64

# --- Registry (image-push, registry-login, k8s-apply) ---------------------------------------
# The image is IMAGE_REGISTRY/OWNER/golang-web:<version.txt>.
# IMAGE_REGISTRY ?= ghcr.io
# OWNER ?= andriykalashnykov
# Login user. Default: OWNER.
# REGISTRY_USERNAME ?= andriykalashnykov
# Credential for registry-login. Prefer `export REGISTRY_TOKEN=...` in your shell;
# .env is gitignored, but it is a plaintext file.
# REGISTRY_TOKEN ?= 
