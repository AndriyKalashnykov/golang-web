# Accepted findings of check-vks-docs.sh. One per line:
#   check | file (relative to vks/) | reason | one exact line of the block (or the link target)
# An entry that allows nothing fails the gate, so remove the entry with the defect it covers.

# Blocks that are not run for their output.
expect | README.md | opens an editor: nothing is printed | "${EDITOR:-nano}" ~/.vks-golang-web.env
expect | ARGOCD-auto.md | opens an editor: nothing is printed | "${EDITOR:-nano}" ~/.vks-argocd.env
expect | REGISTRY.md | lines the reader types into the env file, not a block to run | export REGISTRY_USERNAME='robot$apps+golang-web-push'
expect | REGISTRY.md | lines the reader types into the env file, not a block to run | export REGISTRY_USERNAME='admin'
expect | ARGOCD-manual.md | only assigns the reader's four choices; the next block's If-not covers a miss | NEW_CLUSTER="my-new-cluster"

# Alternatives that share ONE Expect, written after the last of them.
expect | ARGOCD-manual.md | three list commands share the Expect after the third | kubectl --kubeconfig "$SUPERVISOR_KUBECONFIG" get kr
expect | ARGOCD-manual.md | three list commands share the Expect after the third | kubectl --kubeconfig "$SUPERVISOR_KUBECONFIG" -n "$VKS_NAMESPACE" get virtualmachineclass

# The expectation is stated BEFORE the blocks ("each prints nothing"), not as an Expect after them.

# REAL defects in the guides, found by this gate on 2026-10-10 and not yet fixed in the text.
expect | README.md | DEFECT: the certificate-checking renew block has no Expect (the default renew block has one) | KUBECONFIG="$SUPERVISOR_KUBECONFIG" vcf context refresh supervisor --ca-certificate "$SUPERVISOR_CA"
expect | ARGOCD-auto.md | DEFECT: the block that prints the admin password has no Expect | kubectl --kubeconfig "$SUPERVISOR_KUBECONFIG" -n "$VKS_NAMESPACE" get secret argocd-initial-admin-secret -o jsonpath='{.data.password}' | base64 -d; echo

# Step 9 (clean-up) is past the "this terminal until the end of step 8" scope. Its prose tells the
# reader to set NEW_CLUSTER again first, and each If-not names the miss: accepted, not a defect.
env | ARGOCD-manual.md | step 9 says to set NEW_CLUSTER again in a new terminal; the If-not covers a miss | kubectl --kubeconfig "$SUPERVISOR_KUBECONFIG" -n "$VKS_NAMESPACE" delete managedentity "$NEW_CLUSTER"
env | ARGOCD-manual.md | step 9 says to set NEW_CLUSTER again in a new terminal; the If-not covers a miss | ( export KUBECONFIG="$HOME/.kube/${NEW_CLUSTER:?set NEW_CLUSTER first}.kubeconfig"; argocd cluster rm "$(kubectl config current-context)" -y ) && rm -f "$HOME/.kube/${NEW_CLUSTER}.kubeconfig"
env | ARGOCD-manual.md | step 9 says to set NEW_CLUSTER again in a new terminal; the If-not covers a miss | kubectl --kubeconfig "$SUPERVISOR_KUBECONFIG" -n "$VKS_NAMESPACE" get cluster "$NEW_CLUSTER"
